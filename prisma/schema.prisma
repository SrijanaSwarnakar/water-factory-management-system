generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT
  DELIVERY_STAFF
  USER
  CUSTOMER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerType {
  SHOP
  SCHOOL
  HOTEL
  RESTAURANT
  OFFICE
  COMPANY
  HOSPITAL
  INDIVIDUAL
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProductUnit {
  PIECE
  CASE
  CRATE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  CREDIT
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK
  ESEWA
  KHALTI
  CHEQUE
  OTHER
}

enum ReturnCondition {
  GOOD
  DAMAGED
}

enum InventoryTransactionType {
  OPENING
  PRODUCTION
  DELIVERY
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum CustomerTransactionType {
  SALE
  PAYMENT
  SALES_RETURN
  ADJUSTMENT
}

enum EmployeeTransactionType {
  ADVANCE_GIVEN
  CASH_RETURNED
  EXPENSE_CHARGED
  SALARY_ADJUSTMENT
  OTHER
}

enum ExpenseCategory {
  FUEL
  SALARY
  ELECTRICITY
  VEHICLE_REPAIR
  MAINTENANCE
  PACKAGING
  OFFICE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  VOID
  ADJUSTMENT
  PRICE_CHANGE
  CREDIT_OVERRIDE
  STOCK_ADJUSTMENT
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee?
  customer Customer?

  sessions Session[] @relation("UserSessions")
  accounts Account[] @relation("UserAccounts")

  createdOrders                Order[]                      @relation("OrderCreatedBy")
  createdDeliveries            Delivery[]                   @relation("DeliveryCreatedBy")
  createdReturns               Return[]                     @relation("ReturnCreatedBy")
  createdPayments              Payment[]                    @relation("PaymentCreatedBy")
  createdInventoryTransactions InventoryTransaction[]       @relation("InventoryCreatedBy")
  createdCustomerTransactions  CustomerAccountTransaction[] @relation("CustomerTransactionCreatedBy")
  createdEmployeeTransactions  EmployeeAccountTransaction[] @relation("EmployeeTransactionCreatedBy")
  createdExpenses              Expense[]                    @relation("ExpenseCreatedBy")
  createdProductions           Production[]                 @relation("ProductionCreatedBy")
  auditLogs                    AuditLog[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Employee {
  id           String         @id @default(uuid())
  userId       String?        @unique
  employeeCode String         @unique
  name         String
  phone        String?
  address      String?
  joiningDate  DateTime?
  status       EmployeeStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  deliveries          Delivery[]                   @relation("EmployeeDeliveries")
  payments            Payment[]                    @relation("PaymentCollectedBy")
  returns             Return[]                     @relation("ReturnHandledBy")
  accountTransactions EmployeeAccountTransaction[]

  @@index([name])
  @@index([status])
}

model Customer {
  id              String         @id @default(uuid())
  userId          String?        @unique
  customerCode    String         @unique
  name            String
  type            CustomerType
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  creditLimit     Decimal        @default(0) @db.Decimal(12, 2)
  paymentTermDays Int            @default(0)
  status          CustomerStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  prices              CustomerPrice[]
  orders              Order[]                      @relation("CustomerOrders")
  deliveries          Delivery[]                   @relation("CustomerDeliveries")
  returns             Return[]                     @relation("CustomerReturns")
  payments            Payment[]                    @relation("CustomerPayments")
  user             User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountTransactions CustomerAccountTransaction[]

  @@index([name])
  @@index([phone])
  @@index([type])
  @@index([status])
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id                  String        @id @default(uuid())
  productCode         String        @unique
  name                String
  categoryId          String
  unit                ProductUnit   @default(PIECE)
  defaultSellingPrice Decimal       @db.Decimal(12, 2)
  costPrice           Decimal       @db.Decimal(12, 2)
  isReturnable        Boolean       @default(false)
  minimumStock        Int           @default(0)
  status              ProductStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  category              ProductCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  customerPrices        CustomerPrice[]
  orderItems            OrderItem[]
  deliveryItems         DeliveryItem[]
  productionItems       ProductionItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([name])
  @@index([categoryId])
  @@index([status])
}

model CustomerPrice {
  id            String    @id @default(uuid())
  customerId    String
  productId     String
  unitPrice     Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId, effectiveFrom])
  @@index([customerId])
  @@index([productId])
}

model Order {
  id           String      @id @default(uuid())
  orderNo      String      @unique
  customerId   String
  orderDate    DateTime    @default(now())
  expectedDate DateTime?
  status       OrderStatus @default(PENDING)
  notes        String?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer  Customer @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items      OrderItem[]
  deliveries Delivery[]  @relation("OrderDeliveries")

  @@index([customerId])
  @@index([orderDate])
  @@index([status])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveryItems DeliveryItem[] @relation("OrderItemDeliveries")

  @@index([orderId])
  @@index([productId])
}

model Delivery {
  id            String        @id @default(uuid())
  deliveryNo    String        @unique
  orderId       String?
  customerId    String
  employeeId    String
  deliveryDate  DateTime      @default(now())
  dueDate       DateTime?
  paymentStatus PaymentStatus @default(PAID)
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order     Order?   @relation("OrderDeliveries", fields: [orderId], references: [id], onDelete: SetNull)
  customer  Customer @relation("CustomerDeliveries", fields: [customerId], references: [id], onDelete: Restrict)
  employee  Employee @relation("EmployeeDeliveries", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User     @relation("DeliveryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items               DeliveryItem[]
  paymentAllocations  PaymentAllocation[]
  accountTransactions CustomerAccountTransaction[] @relation("DeliveryLedgerTransactions")

  @@index([deliveryDate])
  @@index([customerId])
  @@index([employeeId])
  @@index([paymentStatus])
}

model DeliveryItem {
  id          String  @id @default(uuid())
  deliveryId  String
  orderItemId String?
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  delivery  Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation("OrderItemDeliveries", fields: [orderItemId], references: [id], onDelete: SetNull)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  inventoryTransactions InventoryTransaction[]
  returnItems           ReturnItem[]

  @@index([deliveryId])
  @@index([productId])
  @@index([orderItemId])
}

model Return {
  id          String   @id @default(uuid())
  returnNo    String   @unique
  customerId  String
  employeeId  String?
  returnDate  DateTime @default(now())
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  customer  Customer  @relation("CustomerReturns", fields: [customerId], references: [id], onDelete: Restrict)
  employee  Employee? @relation("ReturnHandledBy", fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items               ReturnItem[]
  accountTransactions CustomerAccountTransaction[] @relation("ReturnLedgerTransactions")

  @@index([customerId])
  @@index([employeeId])
  @@index([returnDate])
}

model ReturnItem {
  id             String          @id @default(uuid())
  returnId       String
  deliveryItemId String
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  condition      ReturnCondition

  return       Return       @relation(fields: [returnId], references: [id], onDelete: Restrict)
  deliveryItem DeliveryItem @relation(fields: [deliveryItemId], references: [id], onDelete: Restrict)

  inventoryTransactions InventoryTransaction[]

  @@index([returnId])
  @@index([deliveryItemId])
}

model Payment {
  id          String        @id @default(uuid())
  paymentNo   String        @unique
  customerId  String
  employeeId  String?
  paymentDate DateTime      @default(now())
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  referenceNo String?
  notes       String?
  createdById String
  createdAt   DateTime      @default(now())

  customer  Customer  @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Restrict)
  employee  Employee? @relation("PaymentCollectedBy", fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  allocations         PaymentAllocation[]
  receipt             Receipt?
  accountTransactions CustomerAccountTransaction[] @relation("PaymentLedgerTransactions")

  @@index([customerId])
  @@index([employeeId])
  @@index([paymentDate])
  @@index([method])
}

model PaymentAllocation {
  id         String  @id @default(uuid())
  paymentId  String
  deliveryId String
  amount     Decimal @db.Decimal(12, 2)

  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([paymentId, deliveryId])
  @@index([deliveryId])
}

model Receipt {
  id          String   @id @default(uuid())
  receiptNo   String   @unique
  paymentId   String   @unique
  receiptDate DateTime @default(now())
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model Production {
  id             String   @id @default(uuid())
  productionNo   String   @unique
  productionDate DateTime @default(now())
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  createdBy User @relation("ProductionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items ProductionItem[]

  @@index([productionDate])
}

model ProductionItem {
  id           String  @id @default(uuid())
  productionId String
  productId    String
  quantity     Int
  unitCost     Decimal @db.Decimal(12, 2)

  production Production @relation(fields: [productionId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  inventoryTransactions InventoryTransaction[]

  @@index([productionId])
  @@index([productId])
}

model InventoryTransaction {
  id               String                   @id @default(uuid())
  productId        String
  transactionType  InventoryTransactionType
  quantity         Int
  unitCost         Decimal?                 @db.Decimal(12, 2)
  totalCost        Decimal?                 @db.Decimal(12, 2)
  transactionDate  DateTime                 @default(now())
  deliveryItemId   String?
  returnItemId     String?
  productionItemId String?
  notes            String?
  createdById      String
  createdAt        DateTime                 @default(now())

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveryItem   DeliveryItem?   @relation(fields: [deliveryItemId], references: [id], onDelete: SetNull)
  returnItem     ReturnItem?     @relation(fields: [returnItemId], references: [id], onDelete: SetNull)
  productionItem ProductionItem? @relation(fields: [productionItemId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([deliveryItemId])
  @@index([returnItemId])
  @@index([productionItemId])
}

model CustomerAccountTransaction {
  id              String                  @id @default(uuid())
  customerId      String
  transactionDate DateTime                @default(now())
  transactionType CustomerTransactionType
  direction       LedgerDirection
  amount          Decimal                 @db.Decimal(12, 2)
  deliveryId      String?
  paymentId       String?
  returnId        String?
  description     String?
  createdById     String
  createdAt       DateTime                @default(now())

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  delivery  Delivery? @relation("DeliveryLedgerTransactions", fields: [deliveryId], references: [id], onDelete: SetNull)
  payment   Payment?  @relation("PaymentLedgerTransactions", fields: [paymentId], references: [id], onDelete: SetNull)
  return    Return?   @relation("ReturnLedgerTransactions", fields: [returnId], references: [id], onDelete: SetNull)
  createdBy User      @relation("CustomerTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([direction])
}

model EmployeeAccountTransaction {
  id              String                  @id @default(uuid())
  employeeId      String
  transactionDate DateTime                @default(now())
  transactionType EmployeeTransactionType
  direction       LedgerDirection
  amount          Decimal                 @db.Decimal(12, 2)
  description     String?
  createdById     String
  createdAt       DateTime                @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User     @relation("EmployeeTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([direction])
}

model Expense {
  id          String          @id @default(uuid())
  expenseNo   String          @unique
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @default(now())
  paidBy      String?
  description String?
  createdById String
  createdAt   DateTime        @default(now())

  createdBy User @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expenseDate])
  @@index([category])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String
  action    AuditAction
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model CompanyProfile {
  id          String   @id @default(uuid())
  companyName String
  address     String
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  taxNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
